# Copier vers ~/.config/ha-kiosk.env sur le Pi
HA_URL=http://192.168.1.51:8123
# Traceur détecté par le routeur (WiFi) — pas le GPS seul
HA_ENTITY=device_tracker.xiaomi_13_lite
# Vue Lovelace (URL signée authSig générée au lancement)
KIOSK_LOVELACE_PATH=/lovelace/musique
KIOSK_BROWSER=firefox-esr
# 0 = plein écran F11 (recommandé si écran blanc en --kiosk)
KIOSK_KIOSK_MODE=0
KIOSK_LEGACY=1
KIOSK_LOVELACE_PATH=/lovelace/ecranmural
# Vide = un seul onglet HA au boot ; exemple 2e onglet : KIOSK_SECOND_URL=https://iahome.fr
KIOSK_SECOND_URL=
# 1 = Firefox natif Wayland (scroll/zoom tactile) ; 0 = XWayland (souvent avec --kiosk)
KIOSK_FIREFOX_WAYLAND=1
# kiosk = vrai plein écran (--kiosk + X11 par défaut) ; f11 = F11 ; fullscreen = maximize Wayfire
# KIOSK_KIOSK_USE_X11=1 force X11 si kiosk (évite écran noir Wayland)
KIOSK_FULLSCREEN=kiosk
KIOSK_KIOSK_USE_X11=1
