# Copier vers ~/.config/ha-kiosk.env sur le Pi
HA_URL=http://192.168.1.51:8123
# Traceur détecté par le routeur (WiFi) — pas le GPS seul
HA_ENTITY=device_tracker.xiaomi_13_lite
# Délai avant extinction écran si absent WiFi / nuit (secondes)
KIOSK_VEILLE_DELAY_SEC=300
# Délai après retour « home » avant réaffichage du dashboard (secondes)
KIOSK_REVEIL_DELAY_SEC=120
# Vue Lovelace (URL signée authSig générée au lancement)
KIOSK_LOVELACE_PATH=/lovelace/ecranmural
KIOSK_BROWSER=firefox-esr
# Pi 5 : obligatoire — firefox -remote plante le navigateur
KIOSK_NO_REMOTE=1
KIOSK_APPLY_FULLSCREEN=0
# 0 = plein écran F11 (recommandé si écran blanc en --kiosk)
KIOSK_KIOSK_MODE=0
KIOSK_LEGACY=1
# (doublon volontairement retiré — une seule ligne KIOSK_LOVELACE_PATH ci-dessus)
# Vide = un seul onglet HA au boot ; exemple 2e onglet : KIOSK_SECOND_URL=https://iahome.fr
KIOSK_SECOND_URL=
# 1 = Firefox natif Wayland (scroll/zoom) ; 0 = XWayland (recommandé Pi 5 — moins d’écran noir / channel error)
KIOSK_FIREFOX_WAYLAND=0
# Retour HA en Chromium (souvent sans ANGLE/GPU sur Pi 5)
KIOSK_HA_USE_CHROMIUM=1
KIOSK_CHROMIUM_HA_FLAGS="--ozone-platform=x11 --disable-gpu --disable-gpu-compositing --disable-dev-shm-usage --disk-cache-size=33554432"
# Garde RAM (Chromium Lovelace ecranmural)
KIOSK_RAM_GUARD_GRACE_SEC=1200
KIOSK_RAM_CHROMIUM_RSS_KB=1400000
# Paramètre kiosk-mode HACS (sidebar+header cachés) : kiosk | hide_sidebar | vide=désactivé
KIOSK_LOVELACE_QUERY=kiosk
# fullscreen = Wayland + start-maximized + règles Wayfire (recommandé Pi 5)
# kiosk = --kiosk (souvent écran noir) ; f11 = F11 si besoin de vrai plein écran
KIOSK_FULLSCREEN=fullscreen
