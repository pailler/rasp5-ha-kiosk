# Copier vers ~/.config/ha-kiosk.env sur le Pi
HA_URL=http://192.168.1.51:8123
# Traceur détecté par le routeur (WiFi) — pas le GPS seul
HA_ENTITY=device_tracker.xiaomi_13_lite
# Vue Lovelace (URL signée authSig générée au lancement)
KIOSK_LOVELACE_PATH=/lovelace/musique
KIOSK_BROWSER=firefox-esr
# Pi 5 : obligatoire — firefox -remote plante le navigateur
KIOSK_NO_REMOTE=1
KIOSK_APPLY_FULLSCREEN=0
# 0 = plein écran F11 (recommandé si écran blanc en --kiosk)
KIOSK_KIOSK_MODE=0
KIOSK_LEGACY=1
KIOSK_LOVELACE_PATH=/lovelace/dashboard-principal
# Vide = un seul onglet HA au boot ; exemple 2e onglet : KIOSK_SECOND_URL=https://iahome.fr
KIOSK_SECOND_URL=
# 1 = Firefox natif Wayland (scroll/zoom) ; 0 = XWayland (recommandé Pi 5 — moins d’écran noir / channel error)
KIOSK_FIREFOX_WAYLAND=0
# fullscreen = Wayland + start-maximized + règles Wayfire (recommandé Pi 5)
# kiosk = --kiosk (souvent écran noir) ; f11 = F11 si besoin de vrai plein écran
KIOSK_FULLSCREEN=fullscreen
KIOSK_FIREFOX_WAYLAND=0
