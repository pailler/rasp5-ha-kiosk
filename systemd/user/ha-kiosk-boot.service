[Unit]
Description=Kiosque Home Assistant (Firefox/Chromium) au démarrage
After=graphical-session.target network-online.target
Wants=graphical-session.target

[Service]
Type=oneshot
TimeoutStartSec=600
ExecStartPre=/bin/sleep 25
ExecStart=%h/bin/start-kiosk-boot.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target
